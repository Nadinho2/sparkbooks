# ============================================================
# SparkBooks — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Clerk Authentication ────────────────────────────────────
# From Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Application URLs ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── DeepSeek AI (Message Parsing) ───────────────────────────
# From DeepSeek Platform -> API Keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ── OpenAI (Whisper Voice Transcription) ─────────────────────
# From OpenAI Platform -> API Keys
OPENAI_API_KEY=your-openai-api-key

# ── Meta WhatsApp Cloud API (v22.0) ──────────────────────────
# From Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
# Custom verification token you enter in Meta Webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-chosen-webhook-verify-token
# From Meta App Dashboard -> App Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Paystack (Billing & Subscriptions) ───────────────────────
# From Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
# Paystack recurring plan codes created in Paystack Dashboard -> Plans
PAYSTACK_STARTER_PLAN_CODE=PLN_...
PAYSTACK_PRO_PLAN_CODE=PLN_...

# ── Cron Job Security ────────────────────────────────────────
# Secret token for authenticating scheduled cron invocations
CRON_SECRET=your-random-cron-secret-32-chars

# ── Resend (Transactional Email & Invitations) ───────────────
# From Resend Dashboard -> API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SparkBooks <noreply@sparkbooks.com.ng>
